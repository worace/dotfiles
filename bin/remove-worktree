#!/bin/bash
set -euo pipefail

script_path="$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")"
# shellcheck source=lib/worktree-lib.sh
source "$(dirname "$script_path")/lib/worktree-lib.sh"

usage() {
    echo "Usage: remove-worktree <name>"
    echo ""
    echo "Removes a git worktree of the current repo and cleans up."
    echo ""
    echo "Outside a repo, WORKTREE_MAIN_REPO from the environment or from"
    echo "~/.config/worktrees/config decides which repo is meant."
    echo ""
    echo "Options:"
    echo "  --list    List all active worktrees"
    exit 1
}

if [[ $# -lt 1 ]]; then
    usage
fi

main_repo="$(worktree_main_repo)"
if [[ -z "$main_repo" ]]; then
    echo "Error: no repo to work in — run from inside one, or set WORKTREE_MAIN_REPO" >&2
    echo "       in the environment or in $(worktree_config_file)" >&2
    exit 1
fi
worktree_base="$(worktree_base "$main_repo")"

if [[ "$1" == "--list" ]]; then
    echo "Active worktrees in $worktree_base:"
    for dir in "$worktree_base"/*/; do
        [[ -d "$dir" ]] || continue
        name=$(basename "$dir")
        branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "detached")
        echo "  $name ($branch)"
    done
    exit 0
fi

name="$1"
worktree_path="$worktree_base/$name"

if [[ ! -d "$worktree_path" ]]; then
    echo "Error: no worktree at $worktree_path"
    echo ""
    echo "Available worktrees:"
    ls "$worktree_base" 2>/dev/null || echo "  (none)"
    exit 1
fi

# Show status before removing
echo "Worktree: $worktree_path"
branch=$(git -C "$worktree_path" branch --show-current 2>/dev/null || echo "detached")
echo "Branch: $branch"

# Warn about uncommitted changes
if [[ -n $(git -C "$worktree_path" status --porcelain 2>/dev/null) ]]; then
    echo ""
    echo "WARNING: This worktree has uncommitted changes:"
    git -C "$worktree_path" status --short
    echo ""
fi

read -p "Remove this worktree? [y/N] " confirm
if [[ "$confirm" != [yY] ]]; then
    echo "Cancelled."
    exit 0
fi

git -C "$main_repo" worktree remove "$worktree_path" --force
echo "Removed worktree '$name'"

# Ask about the branch
read -p "Also delete branch '$branch'? [y/N] " delete_branch
if [[ "$delete_branch" == [yY] ]]; then
    git -C "$main_repo" branch -D "$branch" 2>/dev/null && echo "Deleted branch '$branch'" || echo "Branch not found locally"
fi
