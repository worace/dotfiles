#!/bin/bash
set -euo pipefail

script_path="$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")"
# shellcheck source=lib/worktree-lib.sh
source "$(dirname "$script_path")/lib/worktree-lib.sh"

# How many words of a Linear ticket slug to keep in the derived worktree name.
SLUG_WORDS=4

usage() {
    cat <<'EOF'
Usage: new-worktree <name|linear-url> [base-ref]
       new-worktree -h | --help

Creates a new git worktree and bootstraps its dependencies.

The repo is the one containing the current directory (from a worktree, its main
checkout). Outside a repo, WORKTREE_MAIN_REPO from the environment or from
~/.config/worktrees/config is used. Worktrees are created at
$WORKTREE_ROOT/<repo-name>/<branch>, defaulting to ~/worktrees/<repo-name>/.

Arguments:
  name         Worktree name (used as directory name and branch name)
  linear-url   A Linear issue URL; the worktree name is derived from the
               ticket ID plus the first 4 words of the ticket slug
  base-ref     Git ref to branch from (default: origin/main)

Options:
  -h, --help   Show this help and exit

Bootstrap:
  Runs the repo's setup hook if it has one — `.worktree-setup` at the repo root,
  or ~/.config/worktrees/hooks/<repo-name> — with the new worktree as its cwd
  and WORKTREE_PATH, WORKTREE_BRANCH, and WORKTREE_MAIN_REPO in its
  environment. With no hook, dependencies are installed from whichever
  lockfiles the repo has.

Examples:
  new-worktree eng-1050
  new-worktree eng-1050 origin/main
  new-worktree eng-1050 existing-branch-name
  new-worktree https://linear.app/acme/issue/ENG-3942/local-eval-report-preview-live-synthetic-gallery
      -> worktree/branch ENG-3942-local-eval-report-preview
EOF
}

# Derive a worktree name from a Linear issue URL, or echo the input unchanged
# if it isn't one.
worktree_name() {
    local input="$1"

    if [[ ! "$input" =~ ^(https?://)?(www\.)?linear\.app/[^/]+/issue/([A-Za-z]+-[0-9]+)(/([^?#]*))? ]]; then
        printf '%s\n' "$input"
        return 0
    fi

    local ticket slug
    ticket="$(printf '%s' "${BASH_REMATCH[3]}" | tr '[:lower:]' '[:upper:]')"
    slug="${BASH_REMATCH[5]:-}"
    slug="${slug%%/*}"

    # Lowercase, collapse every run of non-alphanumerics into a single dash.
    slug="$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')"

    local -a parts=()
    local IFS='-'
    read -r -a parts <<< "$slug"

    local suffix="" count=0 part
    for part in ${parts[@]+"${parts[@]}"}; do
        [[ -z "$part" ]] && continue
        suffix="${suffix:+$suffix-}$part"
        count=$((count + 1))
        [[ $count -ge $SLUG_WORDS ]] && break
    done

    printf '%s\n' "${ticket}${suffix:+-$suffix}"
}

# Install whatever the repo's lockfiles call for. Only reached when the repo has
# no setup hook of its own; anything project-shaped belongs in the hook.
install_dependencies() {
    if [[ -f "pnpm-lock.yaml" ]] && command -v pnpm >/dev/null 2>&1; then
        echo "==> Installing node dependencies (pnpm)"
        pnpm install --reporter=silent
    elif [[ -f "yarn.lock" ]] && command -v yarn >/dev/null 2>&1; then
        echo "==> Installing node dependencies (yarn)"
        yarn install --silent
    elif [[ -f "package-lock.json" ]] && command -v npm >/dev/null 2>&1; then
        echo "==> Installing node dependencies (npm ci)"
        npm ci --silent
    elif [[ -f "package.json" ]] && command -v npm >/dev/null 2>&1; then
        echo "==> Installing node dependencies (npm install)"
        npm install --silent
    fi

    if [[ -f "uv.lock" ]] && command -v uv >/dev/null 2>&1; then
        echo "==> Syncing Python dependencies (uv)"
        uv sync --quiet
    elif [[ -f "poetry.lock" ]] && command -v poetry >/dev/null 2>&1; then
        echo "==> Syncing Python dependencies (poetry)"
        poetry install --quiet
    fi

    if [[ -f "Cargo.toml" ]] && command -v cargo >/dev/null 2>&1; then
        echo "==> Fetching Rust dependencies"
        cargo fetch --quiet
    fi
}

# Report on what the bootstrap produced. These are warnings, never failures:
# the hook owns the definition of a correctly set-up worktree for its repo and
# signals a real problem through its exit status.
report_bootstrap() {
    if [[ -f "package.json" ]]; then
        if [[ -d "node_modules" ]]; then
            echo "    OK:   node_modules"
        else
            echo "    WARN: package.json present but no node_modules"
        fi
    fi

    if [[ -f "pyproject.toml" || -f "uv.lock" ]]; then
        if [[ -d ".venv" ]]; then
            echo "    OK:   Python venv"
        else
            echo "    WARN: Python project present but no .venv"
        fi
    fi
}

declare -a args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            args+=(${@+"$@"})
            break
            ;;
        -*)
            echo "Error: unknown option '$1'" >&2
            echo "" >&2
            usage >&2
            exit 1
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

if [[ ${#args[@]} -lt 1 || ${#args[@]} -gt 2 ]]; then
    usage >&2
    exit 1
fi

input="${args[0]}"
base_ref="${args[1]:-origin/main}"

main_repo="$(worktree_main_repo)"
if [[ -z "$main_repo" ]]; then
    echo "Error: no repo to work in — run from inside one, or set WORKTREE_MAIN_REPO" >&2
    echo "       in the environment or in $(worktree_config_file)" >&2
    exit 1
fi
if [[ ! -d "$main_repo/.git" ]]; then
    echo "Error: '$main_repo' is not a git checkout" >&2
    exit 1
fi

name="$(worktree_name "$input")"
if [[ "$name" != "$input" ]]; then
    echo "==> Derived worktree name '$name' from ticket URL"
fi

if [[ -z "$name" ]]; then
    echo "Error: could not derive a worktree name from '$input'" >&2
    exit 1
fi

# A URL that isn't a Linear issue would become a nonsense branch name.
if [[ "$name" =~ ^[a-zA-Z]+:// ]]; then
    echo "Error: '$input' is not a Linear issue URL" >&2
    echo "       Expected https://linear.app/<workspace>/issue/<TICKET-ID>/<slug>" >&2
    exit 1
fi

worktree_path="$(worktree_base "$main_repo")/$name"

if [[ -d "$worktree_path" ]]; then
    echo "Error: worktree already exists at $worktree_path"
    exit 1
fi

echo "==> Creating worktree '$name' from $base_ref in $(basename "$main_repo")"
# A repo with no reachable origin is still worth branching in, so don't let the
# fetch be fatal — the base-ref lookup below reports it if the ref is missing.
git -C "$main_repo" fetch origin --quiet 2>/dev/null \
    || echo "    WARN: could not fetch origin; using the refs already on disk"

# If the base_ref looks like a branch name (not a path like origin/foo),
# check if it already exists as a local or remote branch
if git -C "$main_repo" show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
    echo "    Checking out existing branch '$name'"
    git -C "$main_repo" worktree add "$worktree_path" "$name"
elif git -C "$main_repo" show-ref --verify --quiet "refs/remotes/origin/$name" 2>/dev/null; then
    echo "    Checking out existing remote branch '$name'"
    git -C "$main_repo" worktree add "$worktree_path" "$name"
else
    echo "    Creating new branch '$name' from $base_ref"
    git -C "$main_repo" worktree add "$worktree_path" -b "$name" "$base_ref"
    # Don't track origin/main — first `git push -u` will set the correct upstream
    git -C "$worktree_path" branch --unset-upstream "$name" 2>/dev/null || true
fi

cd "$worktree_path"

if [[ -f "mise.toml" || -f ".mise.toml" ]] && command -v mise >/dev/null 2>&1; then
    echo "==> Trusting mise config"
    mise trust
fi

hook="$(worktree_setup_hook "$main_repo")"
if [[ -n "$hook" ]]; then
    echo "==> Running setup hook $hook"
    WORKTREE_PATH="$worktree_path" \
    WORKTREE_BRANCH="$name" \
    WORKTREE_MAIN_REPO="$main_repo" \
        "$hook"
else
    install_dependencies
fi

echo "==> Bootstrapped"
report_bootstrap

echo ""
echo "Worktree ready at $worktree_path"
echo "Branch: $name"

# Add a tmux window in the dev session if tmux is running
if tmux has-session -t dev 2>/dev/null; then
    tmux new-window -d -t dev -n "$name" -c "$worktree_path"
    echo "Tmux window 'dev:$name' created"
fi
