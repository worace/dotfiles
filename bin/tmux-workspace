#!/bin/bash

MAIN_REPO="$HOME/code/agent_services"
WORKTREE_BASE="$HOME/worktrees/agent_services"

# --- Session: dev - coding windows ---
tmux new-session -d -s dev -n main -c "$MAIN_REPO"

# Add a window for each worktree (sorted alphabetically for stable order)
if [[ -d "$WORKTREE_BASE" ]]; then
    for dir in $(ls -d "$WORKTREE_BASE"/*/ 2>/dev/null | sort); do
        name=$(basename "$dir")
        tmux new-window -t dev -n "$name" -c "$dir"
    done
fi

# --- Session: server - dev server (start manually with pnpm dev) ---
tmux new-session -d -s server -n dev -c "$MAIN_REPO"

# --- Session: infra - docker + ngrok ---
tmux new-session -d -s infra -n procs -c "$MAIN_REPO"

tmux send-keys -t infra:procs 'docker compose up' C-m

tmux split-window -v -t infra:procs -c "$MAIN_REPO"
tmux send-keys -t infra:procs 'ngrok http 8000' C-m

tmux select-layout -t infra:procs even-vertical

# --- Session: dots - dotfiles ---
tmux new-session -d -s dots -n dots -c "$HOME/dotfiles"

# Attach to dev session
tmux attach -t dev
